{
  "version": 1,
  "feature": { "id": "rsvp" },
  "actions": [{
    "id": "rsvp.respond",
    "route": { "method": "POST", "path": "/rsvp" },
    "form": { "template": "routes/rsvp.tsx", "id": "rsvp-response", "documentPath": "/rsvp" },
    "handler": { "file": "routes/rsvp.tsx", "export": "POST", "role": "route" },
    "input": {
      "schema": {
        "kind": "object",
        "properties": {
          "name": { "kind": "string", "minLength": 1 },
          "email": { "kind": "string", "minLength": 1 },
          "attendance": { "kind": "string", "minLength": 1 }
        },
        "required": ["name", "email", "attendance"]
      },
      "formCodec": {
        "encoding": "urlencoded",
        "unknownFields": "reject",
        "bindings": [
          { "name": "name", "path": ["name"], "decode": { "kind": "text", "trim": true, "empty": "reject" } },
          { "name": "email", "path": ["email"], "decode": { "kind": "text", "trim": true, "empty": "reject" } },
          { "name": "attendance", "path": ["attendance"], "decode": { "kind": "text", "trim": true, "empty": "reject" } }
        ]
      }
    }
  }]
}
